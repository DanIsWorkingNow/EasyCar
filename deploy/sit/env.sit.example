# EasyCar — SIT (System Integration Testing) environment.
# deploy/sit/setup.sh copies this to .env.sit and generates APP_KEY.
APP_NAME="EasyCar SIT"
APP_ENV=sit
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8100

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/sit.sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Emails are written to storage/logs/laravel.log so testers can inspect them.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=sit@easycar.test
MAIL_FROM_NAME="EasyCar SIT"

# Payments: sandbox gateway only (no real money).
PAYMENTS_ENABLED=true
PAYMENTS_DEFAULT_GATEWAY=sandbox
PAYMENTS_SANDBOX_ENABLED=true

# Production-like business rules.
COMPLIANCE_REQUIRE_VERIFIED_DRIVER=true
PRICING_DEPOSIT_REQUIRED=true
LOYALTY_ENABLED=true
